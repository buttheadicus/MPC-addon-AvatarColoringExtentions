<?xml version="1.0" encoding="utf-8"?>
<bg xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:noNamespaceSchemaLocation="https://monkeymanboy.github.io/BSML-Docs/BSMLSchema.xsd">
  <vertical pad="4" spacing="2" horizontal-fit="PreferredSize" preferred-width="220">
    <vertical id="PresetListRoot" spacing="1" pad="0"
              child-control-height="true"
              child-expand-height="false"
              child-control-width="true"
              child-expand-width="false"/>
    <horizontal spacing="0" horizontal-fit="PreferredSize" child-align="MiddleCenter" child-expand-width="false">
      <button id="PrevPageButton" text="&lt;" min-height="10" preferred-height="12" preferred-width="12" on-click="PrevPageClicked"/>
      <button id="DeleteModeButton" text="Delete" min-height="10" preferred-height="12" preferred-width="80" on-click="DeleteModeToggleClicked"/>
      <button id="NextPageButton" text="&gt;" min-height="10" preferred-height="12" preferred-width="12" on-click="NextPageClicked"/>
    </horizontal>
    <text id="PageLabel" text="1/1" font-size="3" align="Right"/>
  </vertical>
</bg>
