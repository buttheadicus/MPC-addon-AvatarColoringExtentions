<?xml version="1.0" encoding="utf-8"?>
<bg xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:noNamespaceSchemaLocation="https://monkeymanboy.github.io/BSML-Docs/BSMLSchema.xsd">
  <vertical pad="10" spacing="6">
    <text text="Avatar Coloring Extensions" font-size="5" align="Center"/>
    <toggle-setting id="EnableAvatarColoringToggle" text="Enable (REQUIRES GAME RESET)" value="EnableAvatarColoringDraft"/>
    <text text="Extend your Beat Saber avatar with this addon! Make exotic colors, save/load avatars, or... use the randomize button..." font-size="3.5" align="Center"/>
    <button text="Apply" pad="2" on-click="ApplyClicked"/>
  </vertical>
</bg>
